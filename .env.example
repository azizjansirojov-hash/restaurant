# Supabase (required for production auth + data)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Stripe (required for checkout + peak deposits)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# App environment: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Server-side only (never in the mobile app)
SUPABASE_SERVICE_ROLE_KEY=
# Optional: guest access_token for live create_order tamper test (scripts/supabase-integration-qa.ts)
SUPABASE_TEST_ACCESS_TOKEN=
SUPABASE_TEST_STAFF_TOKEN=
SUPABASE_TEST_OWNER_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
